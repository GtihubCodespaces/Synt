# Copy to .env for development. Never commit .env.

# Skip the Settings screen while developing (the real app stores the key in
# Settings, not in the build).
VITE_TOKENHARBOR_KEY=

# Default is the free route: deepseek-v4.1-flash:free
VITE_MODEL=deepseek-v4.1-flash:free

# Local voice server (see sidecar/README.md)
VITE_TTS_SERVER=http://127.0.0.1:8765

# SyntaxUI has no public upload API today; set this only for a self-hosted
# endpoint that accepts the same multipart form as ui.syntaxdev.store/new.
VITE_SYNTAXUI_UPLOAD_URL=
